# ==========================================
# RENTMANAGER FRONTEND
# Environment Template
# ==========================================

# Application

NEXT_PUBLIC_APP_NAME=RentManager
NEXT_PUBLIC_APP_ENV=development

# Backend
# Must end with /api/v1 - the API client builds request paths on top of it.

NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Authentication (Clerk)
# The "backend" JWT template must exist in the Clerk dashboard and map to
# the issuer configured on the backend (CLERK_JWKS_URL). The same template
# name must match BACKEND_JWT_TEMPLATE in src/lib/auth/token.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Monitoring

NEXT_PUBLIC_SENTRY_DSN=

# Backend runtime variables (set in the backend deployment, not here):
# CORS_ALLOWED_ORIGINS - comma-separated frontend origins (e.g. https://app.rentmanager.com)
# CLERK_JWKS_URL - production Clerk instance JWKS URL
# DARAJA_RATIBA_ENABLED - true to enable automatic monthly collections
# DARAJA_SUBSCRIPTION_BILLING_CALLBACK_URL - public URL of the subscription STK callback
# DARAJA_RATIBA_CALLBACK_URL - public URL of the Ratiba standing-order callback
# DARAJA_CALLBACK_SECRET - shared secret for the M-Pesa callbacks
