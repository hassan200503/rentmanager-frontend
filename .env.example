# RentManager — environment template
# Copy to `.env.local` and fill in real values. Every key below is also
# validated at startup by `src/lib/config/validation.ts`; invalid or missing
# required values fail fast instead of running in a broken state.

# ── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=RentManager
# development | test | production
NEXT_PUBLIC_APP_ENV=development
# Canonical origin used for SEO (metadataBase / OpenGraph). Required for prod.
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_APP_VERSION=0.1.0

# ── Backend API ────────────────────────────────────────────────────────
# API base, INCLUDING the /api/v1 suffix. Every path in lib/api/endpoints.ts
# and the per-feature *-endpoints.ts files is relative and is appended to this
# value verbatim, so omitting /api/v1 here makes every request 404.
# (The Next.js `rewrites` in next.config.ts separately forwards /api/v1/* to
# BACKEND_URL for same-origin calls; this variable is what the browser client
# uses directly.)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ── Auth (Clerk) ───────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Clerk webhook signing secret (Clerk Dashboard -> Webhooks -> Endpoint). Required once the
# /api/webhooks/clerk endpoint is configured; the route fails closed (500) without it.
CLERK_WEBHOOK_SIGNING_SECRET=sk_test_...

# ── Billing (Stripe — optional until wired) ────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Monitoring (Sentry — optional) ─────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
# Shown on /legal/privacy and /legal/terms as the contact for data-protection
# requests. Not a secret. Left blank, both pages say the address is being set
# up rather than printing one that bounces.
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=

# ── Product flags ──────────────────────────────────────────────────────
# "true" unlocks premium features. Declared but read server-side.
ENABLE_PREMIUM_FEATURES=false